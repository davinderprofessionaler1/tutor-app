generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseAccessType {
  LIFETIME
  FIXED_DAYS
}

enum EnrollmentSource {
  PURCHASE
  ADMIN
  COUPON
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationAudience {
  ALL_STUDENTS
  SELECTED_STUDENTS
  COURSE_STUDENTS
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

model User {
  id                 String                  @id @default(cuid())
  email              String?                 @unique
  mobile             String?                 @unique
  passwordHash       String
  firstName          String
  lastName           String
  avatarUrl          String?
  status             UserStatus              @default(PENDING)
  emailVerifiedAt    DateTime?
  mobileVerifiedAt   DateTime?
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  roles              UserRole[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  orders             Order[]
  couponUsages       CouponUsage[]
  deviceTokens       DeviceToken[]
  notificationReads  NotificationRecipient[]
  activityLogs       ActivityLog[]           @relation("ActivityActor")
  contactRequests    ContactRequest[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_categories")
}

model Course {
  id                 String           @id @default(cuid())
  categoryId         String?
  title              String
  slug               String           @unique
  shortDescription   String
  description        String
  thumbnailUrl       String?
  bannerUrl          String?
  originalPrice      Decimal          @db.Decimal(12, 2)
  salePrice          Decimal          @db.Decimal(12, 2)
  currency           String           @default("INR")
  accessType         CourseAccessType @default(LIFETIME)
  accessDays         Int?
  certificateEnabled Boolean          @default(false)
  downloadEnabled    Boolean          @default(false)
  featured           Boolean          @default(false)
  status             CourseStatus     @default(DRAFT)
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  ogImageUrl         String?
  noIndex            Boolean          @default(false)
  noFollow           Boolean          @default(false)
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  category           CourseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sections           CourseSection[]
  lessons            Lesson[]
  enrollments        Enrollment[]
  orderItems         OrderItem[]
  couponCourses      CouponCourse[]
  notifications      Notification[]

  @@index([status, featured])
  @@index([categoryId])
  @@map("courses")
}

model CourseSection {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, sortOrder])
  @@map("course_sections")
}

model Video {
  id            String   @id @default(cuid())
  storageKey    String   @unique
  provider      String
  providerId    String?
  title         String
  description   String?
  thumbnailUrl  String?
  durationSec   Int
  mimeType      String?
  sizeBytes     BigInt?
  downloadReady Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lessons       Lesson[]

  @@map("videos")
}

model Lesson {
  id              String         @id @default(cuid())
  courseId        String
  sectionId       String
  videoId         String?
  title           String
  description     String?
  sortOrder       Int            @default(0)
  isPreview       Boolean        @default(false)
  downloadEnabled Boolean        @default(false)
  isPublished     Boolean        @default(false)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section         CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  video           Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  progress        LessonProgress[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([courseId, sectionId, sortOrder])
  @@map("course_lessons")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  orderItemId String?          @unique
  source      EnrollmentSource
  status      EnrollmentStatus @default(ACTIVE)
  startsAt    DateTime         @default(now())
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([status, expiresAt])
  @@map("enrollments")
}

model LessonProgress {
  id                  String   @id @default(cuid())
  userId              String
  lessonId            String
  watchedSeconds      Int      @default(0)
  lastPositionSeconds Int      @default(0)
  completedAt         DateTime?
  startedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("video_progress")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  couponId       String?
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  currency       String      @default("INR")
  status         OrderStatus @default(PENDING)
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  coupon         Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  couponUsages   CouponUsage[]

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  courseId  String
  title     String
  unitPrice Decimal     @db.Decimal(12, 2)
  discount  Decimal     @default(0) @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course      @relation(fields: [courseId], references: [id])
  enrollment Enrollment?

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  providerPayload   Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerPaymentId])
  @@map("payments")
}

model Coupon {
  id                  String       @id @default(cuid())
  code                String       @unique
  description         String?
  discountType        DiscountType
  discountValue       Decimal      @db.Decimal(12, 2)
  minimumOrderAmount  Decimal?     @db.Decimal(12, 2)
  maximumDiscount     Decimal?     @db.Decimal(12, 2)
  startsAt            DateTime?
  endsAt              DateTime?
  totalUsageLimit     Int?
  perStudentUsageLimit Int?        @default(1)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  orders              Order[]
  courses             CouponCourse[]
  usages              CouponUsage[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponCourse {
  couponId String
  courseId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@map("coupon_courses")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
  @@map("coupon_usages")
}

model CmsPage {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  excerpt        String?
  content        Json
  status         CourseStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean      @default(false)
  noFollow       Boolean      @default(false)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("cms_pages")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  avatarUrl String?
  rating    Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model Notification {
  id          String               @id @default(cuid())
  courseId    String?
  title       String
  body        String
  audience    NotificationAudience
  status      NotificationStatus   @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  course      Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recipients  NotificationRecipient[]

  @@index([status, scheduledAt])
  @@map("notifications")
}

model NotificationRecipient {
  notificationId String
  userId         String
  deliveredAt    DateTime?
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_recipients")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  headerHtml  String?
  bodyHtml    String
  footerHtml  String?
  ctaText     String?
  ctaUrl      String?
  isEnabled   Boolean  @default(true)
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        EmailLog[]

  @@map("email_templates")
}

model EmailLog {
  id             String         @id @default(cuid())
  templateId     String?
  recipient      String
  subject        String
  provider       String?
  providerMessageId String?
  status         String
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  template       EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt])
  @@map("email_logs")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  isSecret    Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model SeoSetting {
  id              String   @id @default(cuid())
  scope           String   @unique
  defaultTitle    String
  titleSuffix     String?
  metaDescription String?
  ogImageUrl      String?
  robots          String?
  updatedAt       DateTime @updatedAt

  @@map("seo_settings")
}

model ThemeSetting {
  id                  String   @id @default(cuid())
  scope               String   @unique
  primaryColor        String
  secondaryColor      String
  accentColor         String
  backgroundColor     String
  cardColor           String
  textColor           String
  mutedTextColor      String
  primaryButtonColor  String
  primaryButtonText   String
  headerColor         String
  footerColor         String
  updatedAt           DateTime @updatedAt

  @@map("theme_settings")
}

model ContactRequest {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_requests")
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("activity_logs")
}
