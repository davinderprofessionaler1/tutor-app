{
  "name": "@tutor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:live": "node --import tsx --test test/live.test.ts",
    "db:migrate:live": "tsx scripts/migrate-live.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@prisma/client": "7.10.0",
    "@tutor/contracts": "workspace:*",
    "dotenv": "18.0.3",
    "fastify": "5.12.5",
    "livekit-server-sdk": "^2.20.0",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
